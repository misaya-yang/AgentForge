# =============================================================================
# AI Gateway Web Configuration
# =============================================================================
# Copy this file to .env.local and modify as needed.
# DO NOT commit .env.local to version control!
# =============================================================================

# Backend API URL (used by vite proxy in development)
# In production, this should point to your actual API server
VITE_API_URL=http://localhost:8080

# API base URL for the generated fetch client (leave empty to use relative paths with proxy)
# Only set this if you need direct API access without proxy
VITE_API_BASE_URL=

# One release in report-only before enforcement. Origins are whitespace-separated,
# without paths or wildcards; include an explicit WS(S) origin when needed.
FRONTEND_CSP_MODE=report-only
FRONTEND_CONNECT_ORIGINS=
FRONTEND_IMAGE_ORIGINS=
