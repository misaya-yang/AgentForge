{
  "name": "ai-gateway-web",
  "version": "2.0.0",
  "description": "AI Gateway Web Console - Frontend for AI Service Gateway",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-bundle-budget.mjs",
    "bundle:budget": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --experimental-strip-types --test 'src/**/*.test.ts'",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "e2e:opensource": "playwright test --config playwright.opensource.config.ts e2e/dynamic-route-render.spec.ts e2e/eval-trace.spec.ts e2e/agent-studio.spec.ts e2e/agent-publish.spec.ts e2e/first-run.spec.ts e2e/nav-groups.spec.ts",
    "e2e": "../scripts/dev/start_e2e_stack.sh test",
    "e2e:headed": "../scripts/dev/start_e2e_stack.sh test --headed"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.2.5",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/react-query": "^5.101.0",
    "antd": "^6.4.4",
    "axios": "^1.18.0",
    "browser-image-compression": "^2.0.2",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.21",
    "dompurify": "^3.4.10",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "katex": "^0.17.0",
    "lucide-react": "^1.18.0",
    "motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.79.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.8.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.6.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.61.1",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": "^26.11.1"
  },
  "packageManager": "pnpm@12.11.2"
}
