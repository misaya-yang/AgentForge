{
  "schema": "ai-gateway/service-topology/v1",
  "revision": "arc06-2026-08-v1",
  "default_mode": "full",
  "groups": [
    {"id": "gateway-control", "display_name": "Gateway Control"},
    {"id": "agent-execution", "display_name": "Agent Execution"},
    {"id": "knowledge", "display_name": "Knowledge"},
    {"id": "infrastructure", "display_name": "Infrastructure"}
  ],
  "compose_modes": {
    "compact": {"files": ["docker-compose.yml", "docker-compose.compact.yml"]},
    "full": {"files": ["docker-compose.yml", "docker-compose.full.yml"]},
    "scale": {"files": ["docker-compose.yml", "docker-compose.scale.yml"]}
  },
  "services": [
    {
      "service_id": "frontend",
      "display_name": "Web Console",
      "bounded_context": "gateway-control",
      "process_role": "Static administrator and user console",
      "lifecycle": "long-running",
      "exposure": "public",
      "required_deps": ["gateway"],
      "optional_deps": [],
      "state_owner": "none",
      "scale_support": "stateless",
      "health_contract": {"kind": "http", "source_key": "frontend"},
      "image_artifact": {"version_env": "FRONTEND_IMAGE", "default_version": "2.0.0"},
      "modes": {"compact": {"present": true, "replicas": 1}, "full": {"present": true, "replicas": 1}, "scale": {"present": true, "replicas": 1}}
    },
    {
      "service_id": "gateway",
      "display_name": "Gateway",
      "bounded_context": "gateway-control",
      "process_role": "Public API, authentication, routing and control plane",
      "lifecycle": "long-running",
      "exposure": "public",
      "required_deps": ["postgres", "redis", "agent-runtime"],
      "optional_deps": ["knowledge-service", "agent-capability-worker"],
      "state_owner": "gateway and assistant control state",
      "scale_support": "single-instance",
      "health_contract": {"kind": "gateway", "source_key": "gateway_core"},
      "image_artifact": {"version_env": "GATEWAY_IMAGE", "default_version": "2.0.0"},
      "modes": {"compact": {"present": true, "replicas": 1}, "full": {"present": true, "replicas": 1}, "scale": {"present": true, "replicas": 1}}
    },
    {
      "service_id": "gateway-init",
      "display_name": "Gateway Init",
      "bounded_context": "gateway-control",
      "process_role": "One-time volume ownership initializer",
      "lifecycle": "one-shot",
      "exposure": "private",
      "required_deps": [],
      "optional_deps": [],
      "state_owner": "none",
      "scale_support": "one-shot",
      "health_contract": {"kind": "completion", "source_key": "gateway-init"},
      "image_artifact": {"version_env": "POSTGRES_IMAGE", "default_version": "16"},
      "modes": {"compact": {"present": true, "replicas": 1}, "full": {"present": true, "replicas": 1}, "scale": {"present": true, "replicas": 1}}
    },
    {
      "service_id": "agent-runtime",
      "display_name": "Agent Runtime",
      "bounded_context": "agent-execution",
      "process_role": "Rust Thread, Turn and Item execution kernel",
      "lifecycle": "long-running",
      "exposure": "private",
      "required_deps": ["postgres", "gateway"],
      "optional_deps": ["agent-capability-worker"],
      "state_owner": "runtime threads, items, snapshots and leases",
      "scale_support": "single-instance",
      "health_contract": {"kind": "gateway-dependency", "source_key": "agent_runtime"},
      "image_artifact": {"version_env": "AI_PLATFORM_AGENT_RUNTIME_IMAGE", "default_version": "candidate"},
      "modes": {"compact": {"present": true, "replicas": 1}, "full": {"present": true, "replicas": 1}, "scale": {"present": true, "replicas": 1}}
    },
    {
      "service_id": "agent-capability-worker",
      "display_name": "Capability Worker",
      "bounded_context": "agent-execution",
      "process_role": "Durable capability and tool execution worker",
      "lifecycle": "long-running",
      "exposure": "private",
      "required_deps": ["postgres", "agent-runtime"],
      "optional_deps": ["knowledge-service", "gateway"],
      "state_owner": "capability execution and event ledger",
      "scale_support": "worker",
      "health_contract": {"kind": "gateway-dependency", "source_key": "capability_worker"},
      "image_artifact": {"version_env": "AGENT_CAPABILITY_WORKER_IMAGE", "default_version": "candidate"},
      "modes": {"compact": {"present": true, "replicas": 1}, "full": {"present": true, "replicas": 1}, "scale": {"present": true, "replicas": 2}}
    },
    {
      "service_id": "local-node",
      "display_name": "Local Node",
      "bounded_context": "agent-execution",
      "process_role": "User-hosted local capability daemon",
      "lifecycle": "external",
      "exposure": "host-local",
      "required_deps": ["gateway"],
      "optional_deps": [],
      "state_owner": "user-host local ledger",
      "scale_support": "per-host",
      "health_contract": {"kind": "external", "source_key": "local-node"},
      "image_artifact": {"version_env": null, "default_version": "external"},
      "modes": {"compact": {"present": false, "replicas": 0}, "full": {"present": false, "replicas": 0}, "scale": {"present": false, "replicas": 0}}
    },
    {
      "service_id": "knowledge-service",
      "display_name": "Knowledge API",
      "bounded_context": "knowledge",
      "process_role": "Knowledge CRUD and retrieval API",
      "lifecycle": "long-running",
      "exposure": "gateway-proxied",
      "required_deps": ["postgres", "qdrant"],
      "optional_deps": ["redis"],
      "state_owner": "knowledge relational and vector state",
      "scale_support": "stateless",
      "health_contract": {"kind": "gateway-dependency", "source_key": "knowledge_service"},
      "image_artifact": {"version_env": "KNOWLEDGE_IMAGE", "default_version": "2.0.0"},
      "modes": {"compact": {"present": true, "replicas": 1, "runtime_role": "all"}, "full": {"present": true, "replicas": 1, "runtime_role": "api"}, "scale": {"present": true, "replicas": 1, "runtime_role": "api"}}
    },
    {
      "service_id": "knowledge-worker",
      "display_name": "Knowledge Worker",
      "bounded_context": "knowledge",
      "process_role": "Durable ingestion and indexing worker",
      "lifecycle": "long-running",
      "exposure": "private",
      "required_deps": ["postgres", "qdrant"],
      "optional_deps": ["redis"],
      "state_owner": "knowledge durable job claims",
      "scale_support": "worker",
      "health_contract": {"kind": "worker", "source_key": "knowledge_worker"},
      "image_artifact": {"version_env": "KNOWLEDGE_IMAGE", "default_version": "2.0.0"},
      "modes": {"compact": {"present": false, "replicas": 0}, "full": {"present": true, "replicas": 1, "runtime_role": "worker"}, "scale": {"present": true, "replicas": 2, "runtime_role": "worker"}}
    },
    {
      "service_id": "migrate",
      "display_name": "Migration Authority",
      "bounded_context": "infrastructure",
      "process_role": "One-time schema migration authority",
      "lifecycle": "one-shot",
      "exposure": "private",
      "required_deps": ["postgres"],
      "optional_deps": [],
      "state_owner": "schema baseline and change ledgers",
      "scale_support": "one-shot",
      "health_contract": {"kind": "completion", "source_key": "migrate"},
      "image_artifact": {"version_env": "MIGRATE_IMAGE", "default_version": "2.0.0"},
      "modes": {"compact": {"present": true, "replicas": 1}, "full": {"present": true, "replicas": 1}, "scale": {"present": true, "replicas": 1}}
    },
    {
      "service_id": "postgres",
      "display_name": "PostgreSQL",
      "bounded_context": "infrastructure",
      "process_role": "Relational system of record",
      "lifecycle": "long-running",
      "exposure": "private",
      "required_deps": [],
      "optional_deps": [],
      "state_owner": "all relational domains",
      "scale_support": "stateful",
      "health_contract": {"kind": "gateway-dependency", "source_key": "database"},
      "image_artifact": {"version_env": "POSTGRES_IMAGE", "default_version": "16"},
      "modes": {"compact": {"present": true, "replicas": 1}, "full": {"present": true, "replicas": 1}, "scale": {"present": true, "replicas": 1}}
    },
    {
      "service_id": "redis",
      "display_name": "Redis",
      "bounded_context": "infrastructure",
      "process_role": "Cache and coordination store",
      "lifecycle": "long-running",
      "exposure": "private",
      "required_deps": [],
      "optional_deps": [],
      "state_owner": "non-authoritative cache and coordination state",
      "scale_support": "stateful",
      "health_contract": {"kind": "gateway-dependency", "source_key": "redis"},
      "image_artifact": {"version_env": "REDIS_IMAGE", "default_version": "7"},
      "modes": {"compact": {"present": true, "replicas": 1}, "full": {"present": true, "replicas": 1}, "scale": {"present": true, "replicas": 1}}
    },
    {
      "service_id": "qdrant",
      "display_name": "Qdrant",
      "bounded_context": "infrastructure",
      "process_role": "Knowledge vector store",
      "lifecycle": "long-running",
      "exposure": "private",
      "required_deps": [],
      "optional_deps": [],
      "state_owner": "knowledge vector collections",
      "scale_support": "stateful",
      "health_contract": {"kind": "dependency", "source_key": "qdrant"},
      "image_artifact": {"version_env": "QDRANT_IMAGE", "default_version": "1.18.2"},
      "modes": {"compact": {"present": true, "replicas": 1}, "full": {"present": true, "replicas": 1}, "scale": {"present": true, "replicas": 1}}
    },
    {
      "service_id": "tempo",
      "display_name": "Tempo",
      "bounded_context": "infrastructure",
      "process_role": "Optional trace store",
      "lifecycle": "optional",
      "exposure": "private",
      "required_deps": [],
      "optional_deps": ["gateway", "knowledge-service"],
      "state_owner": "trace retention",
      "scale_support": "stateful",
      "health_contract": {"kind": "optional", "source_key": "tempo"},
      "image_artifact": {"version_env": "TEMPO_IMAGE", "default_version": "2.5.0"},
      "modes": {"compact": {"present": false, "replicas": 0}, "full": {"present": false, "replicas": 0}, "scale": {"present": false, "replicas": 0}}
    }
  ]
}
