{
  "schema_version": "general-agent-failure-suite/v1",
  "suite_id": "assistant.general-agent.failure-recovery.v1",
  "acceptance": "Every deterministic hard gate must pass in every repetition; no weighted score or LLM override is permitted.",
  "cases": [
    {
