      "required_gates": [
        "unknown_write_blocked",
        "unknown_write_not_retried",
        "sibling_cancelled",
        "no_sibling_write",
        "one_terminal_per_child",
        "recovery_receipt_complete"
      ]
    },
    {
      "case_id": "legal.regulatory-export-timeout",
      "domain": "legal and regulatory analysis",
      "critical": true,
      "repetitions": 3,
      "fault": "A read-only regulatory evidence export hangs beyond the parent deadline during a legal citation review.",
      "required_gates": [
        "deadline_enforced",
        "blocked_tool_cancelled",
        "failed_terminal_emitted_once",
        "no_orphan_child"
      ]
    },
    {
      "case_id": "orchestration.stale-terminal-replay",
      "domain": "agent orchestration",
      "critical": true,
      "repetitions": 3,
      "fault": "A completed receipt from an earlier attempt is replayed after the parent has started a new attempt.",
      "required_gates": [
        "original_receipt_valid",
        "stale_attempt_rejected",
        "split_attempt_tamper_rejected",
        "receipt_has_authoritative_shape"
      ]
    },
    {
