{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "ai-quiz",
  "version": "1.1.0",
  "description": "Signed ai-quiz compiled plugin: governed quiz generation persistence, deterministic grading and tenant-scoped artifact sharing.",
  "author": {
    "name": "AI Gateway Maintainers"
  },
  "license": "MIT",
  "keywords": [
    "quiz",
    "exam",
    "knowledge-base",
    "assessment",
    "learning"
  ],
  "extensions": {
    "com.misaya.ai-gateway": {
      "skills": [
        "./skills/quiz-generation/SKILL.md"
      ],
      "agents": [
        "./agents/quiz-expert.md"
      ],
      "worker_capabilities": [
        "generate_quiz"
      ],
      "implementation": {
        "crate": "ai-platform-plugin-quiz",
        "delivery": "compiled-plugin",
        "package_signatures": "minisign-Ed",
        "executable_payload": false
      },
      "publisher_id": "agentforge-maintainers"
    }
  }
}
