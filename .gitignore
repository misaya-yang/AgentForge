# =============================================================================
# AI Gateway .gitignore
# =============================================================================

# ======================== Environment & Secrets ========================
# Local environment configuration (contains secrets).
# Also covers ad-hoc backups (.env.bak.YYYYMMDD-HHMMSS) and scratch
# copies (.env.copy) that prior ops sessions left behind — they contain
# the same secrets as the live .env and must never be committed.
.env
.env.*
!.env.example
!.env.*.example
.envrc
*.env
*.pem
*.key
*.p12
*.pfx
credentials.json
credentials.*.json
secrets.json
secrets.*.json
!credentials.example.json
!secrets.example.json
.netrc
.pypirc
id_rsa
id_ed25519
.ssh/
.aws/
*.local.json
*.local.toml
*.local.yml
*.local.yaml
/config/local/
/.tools/

# ======================== Python ========================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/

