sdk/cli/vendor/*/
sdk/cli/vendor/source.json

# ======================== OS Generated ========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Windows reserved names
nul
NUL

# ======================== Debug & Temporary Scripts ========================
# Root-anchored (leading `/`): these patterns describe junk that tooling drops in
# the working directory, not a file-naming rule for the whole tree. Unanchored,
# `check_*.py` silently swallowed scripts/harness/check_harness.py — the gate that
# CI runs — which is exactly the failure mode this anchoring prevents.
/check_*.py
/check_*.json
/quick_test*.py
/test_output*.txt
/*_debug.py
/debug_*.py
.worktrees
.mcp.json
apps/islamic-content-service/data/

# ======================== Screenshots & Playwright ========================
# Product images, documentation images and fixture images are source assets.
# Browser artifacts belong in the explicit ignored output directories below.
.playwright-mcp/
playwright-report/
.playwright/
blob-report/
*.har

# ======================== Audit & Planning Scratch ========================
# Ad-hoc artifacts dropped at the repository ROOT by tooling. These patterns are
# deliberately root-anchored (leading `/`): unanchored, they silently swallowed
# legitimate documents anywhere in the tree, including under docs/ and reports/.
/*-Audit-*.md
/*-Optimization-*.md
/*-Report*.md
/*-Report*.docx
/*-Report*.js
/*-Spec.md
/claude-code-*.md
# plans/ holds migration plans and generated reports. Track .md + .json
# (committable deliverables); ignore any other scratch/binary artifacts
# that land alongside.
plans/*
!plans/*.md
!plans/*.json
# Verify scripts belong with their design docs so "the gate the user
# runs" is always reviewable next to the spec it enforces.
!plans/verify-*.sh

# ======================== Temporary Upload/Data ========================
tmp-*/
demo-screenshots/
Users/
code-review-recommended-questions.md
deploy-checklist-recommended-questions.md

# ======================== Generated / Temp ========================
web/package-lock.json
# Generated data files
data/hadith_registry.json

# Old reports (root only)
/AI-*.md
/CLAUDE_CODE_OPTIMIZATION_PROMPT.md

# Test output
test-results/
.claude/worktrees/

# Scratch orchestration scripts written during live evaluation runs.
# These embed machine-specific temp paths (e.g. /tmp/<run-id>/auth.env).
.tmp-*
