{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "verifierImage",
    "images",
    "canary"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "verifierImage": {
      "type": "string"
    },
    "images": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^ghcr\\.io/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$"
      }
    },
    "canary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "bootstrapAccepted",
        "frontendDeployment",
        "releaseName",
        "prometheusAddress",
        "prometheusBearerSecret",
        "replicas"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "bootstrapAccepted": {
          "type": "boolean"
        },
        "frontendDeployment": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "releaseName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "prometheusAddress": {
          "type": "string",
          "pattern": "^$|^https?://[A-Za-z0-9][A-Za-z0-9.:-]*(/[A-Za-z0-9._/-]*)?$"
        },
        "prometheusBearerSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
        },
        "replicas": {
          "type": "integer",
          "minimum": 4,
          "maximum": 100
        }
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
