# PUBLIC NAMES ONLY. Merge selected private values into the existing ignored env.
# Nothing here starts services or migrates the existing dev Redis volume.
VALKEY9_IMAGE=docker.io/valkey/valkey:9.1.2@sha256:REPLACE_WITH_VERIFIED_DIGEST
# Verify actual selected image UID/GID; do not assume a numeric identity.
VALKEY_UID=REPLACE_WITH_NONROOT_UID
VALKEY_GID=REPLACE_WITH_NONROOT_GID
VALKEY_COORD_ACL_FILE=/absolute/private/coord.acl
VALKEY_CACHE_ACL_FILE=/absolute/private/cache.acl
VALKEY_COORD_TLS_CERT_FILE=/absolute/private/coord.crt
VALKEY_COORD_TLS_KEY_FILE=/absolute/private/coord.key
VALKEY_CACHE_TLS_CERT_FILE=/absolute/private/cache.crt
VALKEY_CACHE_TLS_KEY_FILE=/absolute/private/cache.key
VALKEY_CA_FILE=/absolute/public/valkey-ca.pem
VALKEY_COORD_HEALTH_PASSWORD_FILE=/absolute/private/coord-health.password
VALKEY_CACHE_HEALTH_PASSWORD_FILE=/absolute/private/cache-health.password
VALKEY_GATEWAY_COORD_PASSWORD_FILE=/absolute/private/gateway-coord.password
VALKEY_GATEWAY_CACHE_PASSWORD_FILE=/absolute/private/gateway-cache.password
VALKEY_KNOWLEDGE_API_COORD_PASSWORD_FILE=/absolute/private/knowledge-api-coord.password
VALKEY_KNOWLEDGE_API_CACHE_PASSWORD_FILE=/absolute/private/knowledge-api-cache.password
VALKEY_KNOWLEDGE_WORKER_COORD_PASSWORD_FILE=/absolute/private/knowledge-worker-coord.password
VALKEY_KNOWLEDGE_WORKER_CACHE_PASSWORD_FILE=/absolute/private/knowledge-worker-cache.password
