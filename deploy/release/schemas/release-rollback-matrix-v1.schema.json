{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-platform/release-rollback-matrix/v1",
  "title": "AI Platform release and rollback evidence matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "release_id", "source_git_sha", "scenarios"],
  "properties": {
    "schema_version": {"const": "ai-platform/release-rollback-matrix/v1"},
    "status": {"enum": ["NOT_RUN", "BLOCKED", "FAIL", "PASS"]},
    "release_id": {"type": ["string", "null"]},
    "source_git_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "tier", "category", "required", "commands", "status", "evidence", "blocker"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "tier": {"enum": ["L1", "L2", "L3"]},
          "category": {"enum": ["release", "rollback"]},
          "required": {"const": true},
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "status": {"enum": ["NOT_RUN", "BLOCKED", "FAIL", "PASS"]},
          "evidence": {"type": "array", "items": {"type": "string", "pattern": "^reports/"}},
          "blocker": {"type": ["string", "null"]}
        }
      }
    }
  }
}
