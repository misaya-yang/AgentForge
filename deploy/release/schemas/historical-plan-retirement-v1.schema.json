{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ai-platform/historical-plan-retirement/v1",
  "title": "AI Platform historical non-PRD plan retirement manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authoritative_successor", "entries"],
  "properties": {
    "schema_version": {"const": "ai-platform/historical-plan-retirement/v1"},
    "authoritative_successor": {"type": "string", "minLength": 1},
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "lifecycle", "successor", "reason", "document_marker"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "lifecycle": {"enum": ["superseded", "archived"]},
          "successor": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "document_marker": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
