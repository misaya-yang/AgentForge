{
  "schema": "agentforge-recovery/v1",
  "repo_root": "/opt/agentforge",
  "target_id": "local-recovery",
  "database": "agentforge",
  "role_prefix": "af_",
  "baseline": "2026_08_post_kb_v1",
  "stanza": "agentforge",
  "pg_backup_principal": "postgres",
  "pg_source_port": 5432,
  "pg_drill_port": 25432,
  "pg_source_path": "/var/lib/postgresql/data",
  "pg_source_dsn_file": "/etc/agentforge-recovery/source.dsn",
  "pg_drill_dsn_file": "/etc/agentforge-recovery/drill.dsn",
  "pgbackrest_bin": "/usr/bin/pgbackrest",
  "pg_ctl_bin": "/usr/lib/postgresql/17/bin/pg_ctl",
  "pgbackrest_config": "/etc/agentforge-recovery/pgbackrest.conf",
  "pgbackrest_include_dir": "/etc/agentforge-recovery/empty-conf.d",
  "qdrant_source": "http://127.0.0.1:6333",
  "qdrant_drill": "http://127.0.0.1:26333",
  "qdrant_source_key_file": "/etc/agentforge-recovery/qdrant-source.key",
  "qdrant_drill_key_file": "/etc/agentforge-recovery/qdrant-drill.key",
  "s3_source": "https://127.0.0.1:19000",
  "s3_replica": "https://127.0.0.1:29000",
  "s3_drill": "https://127.0.0.1:39000",
  "s3_region": "us-east-1",
  "s3_access_key_file": "/etc/agentforge-recovery/s3-access.key",
  "s3_secret_key_file": "/etc/agentforge-recovery/s3-secret.key",
  "s3_ca_certificate_file": "/etc/agentforge-recovery/storage-ca.pem",
  "bucket": "agentforge-backup",
  "replica_bucket": "agentforge-replica",
  "drill_bucket": "af-drill-quarterly-unique",
  "object_prefix": "content/",
  "evidence_root": "/var/lib/agentforge-recovery/evidence",
  "drill_root": "/var/lib/agentforge-recovery/drills",
  "timeout_seconds": 1800,
  "max_snapshot_bytes": 5368709120
}
