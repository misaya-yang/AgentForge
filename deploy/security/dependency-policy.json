{
  "schema_version": "agentforge/dependency-policy/v1",
  "cargo_deny_version": "0.20.2",
  "blocked_packages": [
    "serde_yaml",
    "serde_yml"
  ],
  "blocked_prefixes": [
    "rustpython-"
  ],
  "registry_sources": [
    "registry+https://github.com/rust-lang/crates.io-index",
    "sparse+https://index.crates.io/"
  ],
  "yaml_alias": "serde_yaml",
  "yaml_package": "serde_norway",
  "yaml_version": "0.9.42",
  "yaml_members": [
    "ai-platform-agent-plugins",
    "ai-platform-config-loader",
    "ai-platform-eval",
    "ai-platform-gateway",
    "ai-platform-gateway-foundation",
    "ai-platform-migration-authority",
    "ai-platform-tools"
  ],
  "allowed_spdx_expressions": [
    "MIT",
    "Apache-2.0",
    "Apache-2.0 OR MIT",
    "MIT OR Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "Zlib",
    "BSL-1.0",
    "CC0-1.0",
    "Unicode-3.0",
    "Unicode-DFS-2016",
    "OpenSSL",
    "MIT AND ISC AND OpenSSL",
    "ISC AND MIT AND OpenSSL"
  ]
}
