  "test_builds_redacted_dataset_case_from_trace": [
    {
      "trace": {
        "trace_id": "44444444-4444-4444-4444-444444444444",
        "trace_family": "assistant",
        "status": "failed",
        "input_preview": "Authorization: Bearer raw-token user asks",
        "output_preview": "api_key=secret-value failed",
        "thread_id": "thread-1",
        "run_id": "run-1",
        "redaction_state": {
          "payloads": "redacted_truncated"
        },
        "metadata": {
          "raw_input": "do not copy",
          "Authorization": "Bearer raw-token",
          "api_key": "secret-value",
          "note": "token=secret-value",
          "runtime_trajectory": {
            "schema_version": "assistant-runtime-trajectory/v1",
            "exit_reason": "approval_required",
            "context_snapshot_id": "ctx_safe",
            "memory": {
              "runtime_memory_provenance_count": 2
            },
            "trace_writer_health": {
              "issue_count": 0
            },
            "transcript_locator": {
              "turn_index": 3,
              "bounded": true
            }
          }
        }
      },
      "events": [
        {
          "event_type": "approval_required",
          "payload": {}
        },
        {
          "event_type": "memory_sync",
          "payload": {
            "memory_sync": {
              "status": "skipped"
            }
          }
        },
        {
          "event_type": "context_compacted",
          "payload": {
            "pre_compaction_flush": {
              "status": "flushed"
            }
          }
        }
      ],
      "spans": [
        {
          "span_kind": "tool",
          "attributes": {
            "gateway_policy_decision": {
              "decision": "deny"
            },
            "sandbox_decision": {
              "decision": "blocked"
            },
            "direct_registry_denied": true
          }
        }
      ]
    }
  ],
