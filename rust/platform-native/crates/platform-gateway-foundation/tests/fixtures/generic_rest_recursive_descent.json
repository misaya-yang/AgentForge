[
  {
    "path": "$..name",
    "data": {
      "name": "root",
      "z": {
        "name": "first"
      },
      "a": [
        {
          "name": "second"
        },
        {
          "name": "third"
        }
      ]
    },
    "expected": [
      "root",
      "first",
      "second",
      "third"
    ]
  },
  {
    "path": "$..a.b",
    "data": {
      "a": {
        "b": "outer",
        "a": {
          "b": "nested"
        }
      },
      "z": {
        "a": {
          "b": "last"
        }
      }
    },
    "expected": [
      "outer",
      "nested",
      "last"
    ]
  },
  {
    "path": "$..a..b",
    "data": {
      "a": {
        "b": "outer",
        "a": {
          "b": "nested"
        }
      }
    },
    "expected": [
      "outer",
      "nested",
      "nested"
    ]
  },
  {
    "path": "$..*",
    "data": {
      "z": [
        {
          "a": 1
        }
      ],
      "b": 2
    },
    "expected": [
      [
        {
          "a": 1
        }
      ],
      2,
      1
    ]
  },
  {
    "path": "$..[*]",
    "data": {
      "a": [
        0,
        false,
        null,
        "x"
      ]
    },
    "expected": [
      {
        "a": [
          0,
          false,
          null,
          "x"
        ]
      },
      0,
      false,
      null,
      "x",
      0,
      false,
      "x"
    ]
  },
  {
    "path": "$..missing",
    "data": {
      "a": [
        1
      ]
    },
    "expected": null
  },
  {
    "path": "$..a[0]",
    "data": {
      "a": [
        1,
        2
      ],
      "b": {
        "a": [
          3
        ]
      }
    },
    "expected": [
      1,
      3
    ]
  },
  {
    "path": "$..a.[0]",
    "data": {
      "a": [
        1,
        2
      ],
      "b": {
        "a": [
          3
        ]
      }
    },
    "expected": [
      1,
      3
    ]
  },
  {
    "path": "$..a,b",
    "data": {
      "a": 1,
      "b": 2,
      "c": {
        "a": 3
      }
    },
    "expected": [
      1,
      2,
      3
    ]
  },
  {
    "path": "$..a[0].b",
    "data": {
      "a": [
        {
          "b": 1
        }
      ],
      "z": {
        "a": [
          {
            "b": 2
          }
        ]
      }
    },
    "expected": [
      1,
      2
    ]
  },
  {
    "path": "$..[0]",
    "data": {
      "a": 1
    },
    "error": true
  },
  {
    "path": "$..a[::-1]",
    "data": {
      "a": [
        1,
        2
      ],
      "b": {
        "a": [
          3,
          4
        ]
      }
    },
    "expected": [
      2,
      1,
      4,
      3
    ]
  }
]
