            RAISE EXCEPTION 'ARC03 relocation type % matched % objects', desired.name, matches;
        END IF;
        IF source_schema <> desired.target_schema THEN
            EXECUTE format(
                'ALTER TYPE %I.%I SET SCHEMA %I',
                source_schema, desired.name, desired.target_schema
            );
        END IF;
    END LOOP;
END
$$;
