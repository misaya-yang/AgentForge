# =============================================
# Knowledge Base Microservice Configuration
# All vars use KNOWLEDGE_ prefix
# =============================================

# --- App ---
KNOWLEDGE_APP__HOST=0.0.0.0
KNOWLEDGE_APP__PORT=8092
KNOWLEDGE_APP__LOG_LEVEL=INFO
KNOWLEDGE_APP__ALLOW_ANONYMOUS=false

# --- Database (PostgreSQL) ---
KNOWLEDGE_DATABASE__DSN=postgresql://kb_app:change_me@postgres:5432/gateway
KNOWLEDGE_DATABASE__POOL_MIN_SIZE=2
KNOWLEDGE_DATABASE__POOL_MAX_SIZE=10

# --- Redis (optional, for retrieval cache) ---
KNOWLEDGE_REDIS__ENABLED=false
KNOWLEDGE_REDIS__URL=redis://localhost:6379/2

# --- Durable HTTP idempotency ---
# Redis is the default so retries remain deduplicated across API replicas and
# process restarts. `memory` is accepted only with an explicit local/test
# ENVIRONMENT and must never be used for shared deployments.
ENVIRONMENT=local
INTERNAL_IDEMPOTENCY_BACKEND=redis
INTERNAL_IDEMPOTENCY_TTL_SECONDS=86400
INTERNAL_COMM_REDIS_URL=redis://localhost:6379/3

# --- Qdrant ---
KNOWLEDGE_QDRANT__URL=http://localhost:6333
KNOWLEDGE_QDRANT__API_KEY=
KNOWLEDGE_QDRANT__PREFER_GRPC=false
KNOWLEDGE_QDRANT__TIMEOUT_SECONDS=120.0
KNOWLEDGE_QDRANT__MAX_RETRIES=5
KNOWLEDGE_QDRANT__RETRY_BASE_DELAY=2.0

# --- Text Embedding ---
KNOWLEDGE_EMBEDDINGS__PROVIDER=gemini
KNOWLEDGE_EMBEDDINGS__API_KEY=
KNOWLEDGE_EMBEDDINGS__MODEL=gemini-embedding-001
KNOWLEDGE_EMBEDDINGS__DIMENSION=1024
KNOWLEDGE_EMBEDDINGS__BATCH_SIZE=50
KNOWLEDGE_EMBEDDINGS__MAX_CONCURRENT=5
KNOWLEDGE_EMBEDDINGS__BASE_URL=
KNOWLEDGE_EMBEDDINGS__TIMEOUT_SECONDS=30.0
# Self-hosted OpenAI-compatible embedding server (vLLM / TEI), e.g.
# Qwen3-Embedding. Used when KNOWLEDGE_EMBEDDINGS__PROVIDER=openai_compatible.
# No base-URL default on purpose: fail closed over silently using a public
# cloud endpoint.
KNOWLEDGE_EMBEDDINGS__OPENAI_COMPATIBLE_API_KEY=
KNOWLEDGE_EMBEDDINGS__OPENAI_COMPATIBLE_BASE_URL=

# --- Multimodal Embedding ---
KNOWLEDGE_MULTIMODAL__PROVIDER=dashscope
KNOWLEDGE_MULTIMODAL__API_KEY=
KNOWLEDGE_MULTIMODAL__MODEL=tongyi-embedding-vision-plus
KNOWLEDGE_MULTIMODAL__DIMENSION=1024
KNOWLEDGE_MULTIMODAL__MAX_CONCURRENT=5

# --- OCR ---
KNOWLEDGE_OCR__ENABLED=true
KNOWLEDGE_OCR__STRATEGY=hybrid
KNOWLEDGE_OCR__LANGUAGES=eng+ara
KNOWLEDGE_OCR__RENDER_DPI=200
KNOWLEDGE_OCR__PAGE_CONCURRENCY=3
KNOWLEDGE_OCR__TESSERACT_TIMEOUT_SECONDS=60
KNOWLEDGE_OCR__VLM_PROVIDER=dashscope
KNOWLEDGE_OCR__VLM_MODEL=qwen-vl-ocr
KNOWLEDGE_OCR__VLM_TASK=document_parsing
KNOWLEDGE_OCR__VLM_MIN_PIXELS=3072
KNOWLEDGE_OCR__VLM_MAX_PIXELS=8388608
KNOWLEDGE_OCR__VLM_MAX_TOKENS=8192
KNOWLEDGE_OCR__VLM_ENABLE_ROTATE=true
KNOWLEDGE_OCR__VLM_CONCURRENCY=4
KNOWLEDGE_OCR__VLM_TIMEOUT_SECONDS=30
# Credentials and the region endpoint are read from DASHSCOPE_OCR_API_KEY and
# DASHSCOPE_OCR_BASE_URL in the service environment; never commit them here.

# --- Processing ---
KNOWLEDGE_PROCESSING__WORKER_CONCURRENCY=2
KNOWLEDGE_PROCESSING__DOCUMENT_WORKER_CONCURRENCY=3
KNOWLEDGE_PROCESSING__LARGE_FILE_THRESHOLD=52428800
KNOWLEDGE_PROCESSING__MAX_MEMORY_PROCESSING_SIZE=104857600
KNOWLEDGE_PROCESSING__STREAMING_BATCH_SIZE=20

# --- Chunking ---
KNOWLEDGE_PROCESSING__HIERARCHICAL_L2_CHUNK_SIZE=8000
KNOWLEDGE_PROCESSING__HIERARCHICAL_L2_CHUNK_OVERLAP=400
KNOWLEDGE_PROCESSING__HIERARCHICAL_L3_CHUNK_SIZE=2000
KNOWLEDGE_PROCESSING__HIERARCHICAL_L3_CHUNK_OVERLAP=200

# --- Retrieval ---
KNOWLEDGE_PROCESSING__DATASET_FANOUT_MAX_CONCURRENCY=3
KNOWLEDGE_PROCESSING__RETRIEVAL_QUERY_MAX_CONCURRENCY=3
KNOWLEDGE_PROCESSING__RETRIEVAL_CACHE_TTL_SECONDS=45

# --- PDF Split ---
KNOWLEDGE_PROCESSING__PDF_SPLIT_ENABLED=true
KNOWLEDGE_PROCESSING__PDF_SPLIT_MAX_SIZE_BYTES=20971520
KNOWLEDGE_PROCESSING__PDF_SPLIT_MIN_PAGES_PER_PART=5

# --- Storage (for uploaded files / images) ---
KNOWLEDGE_STORAGE__BACKEND=local
KNOWLEDGE_STORAGE__LOCAL_BASE_PATH=./data/files
KNOWLEDGE_STORAGE__URL_EXPIRY_SECONDS=3600
KNOWLEDGE_STORAGE__KEY_PREFIX=dev
KNOWLEDGE_STORAGE__S3_BUCKET=
KNOWLEDGE_STORAGE__S3_REGION=us-east-1
KNOWLEDGE_STORAGE__S3_ACCESS_KEY=
KNOWLEDGE_STORAGE__S3_SECRET_KEY=
KNOWLEDGE_STORAGE__S3_ENDPOINT_URL=
