{
  "uid": "agentforge-operations",
  "title": "AgentForge Operations",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gateway_requests_total[5m]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API availability burn (99.9%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gateway:slo_error_ratio:5m / 0.001"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency burn (99% under 2.5s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "gateway:slo_slow_ratio:5m / 0.01"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Admission rejection rate",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(admission_rejected_total[5m]))"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Metrics scrape health",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"gateway\"}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "P95 request latency (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gateway_request_duration_ms_bucket[5m])))"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Provider first text chunk P95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(gen_ai_client_operation_time_to_first_chunk_seconds_bucket[5m])))",
          "legendFormat": "{{gen_ai_operation_name}} {{agentforge_tenant_id}} {{gen_ai_request_model}} {{gen_ai_token_type}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Agent/retrieval/ingestion P95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le,gen_ai_operation_name) (rate(gen_ai_client_operation_duration_seconds_bucket[5m])))",
          "legendFormat": "{{gen_ai_operation_name}} {{agentforge_tenant_id}} {{gen_ai_request_model}} {{gen_ai_token_type}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Settled cost rate by opaque tenant/model",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agentforge_tenant_id,gen_ai_request_model) (rate({__name__=~\"agentforge_gen_ai_cost.*_total\"}[5m]))",
          "legendFormat": "{{gen_ai_operation_name}} {{agentforge_tenant_id}} {{gen_ai_request_model}} {{gen_ai_token_type}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Settled token rate by tenant/model/direction",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (agentforge_tenant_id,gen_ai_request_model,gen_ai_token_type) (rate({__name__=~\"agentforge_gen_ai_token_usage.*_total\"}[5m]))",
          "legendFormat": "{{gen_ai_operation_name}} {{agentforge_tenant_id}} {{gen_ai_request_model}} {{gen_ai_token_type}}"
        }
      ]
    }
  ]
}
