          "run_id": "00000000-0000-4000-8000-000000000001",
          "engine": "openai_agents",
          "status": "completed",
          "usage": {
            "output_tokens": 2,
            "input_tokens_details": {
              "cached_tokens": 4
            },
            "sdk_usage": {
              "state": "unavailable",
              "cost_state": "reported",
              "provider_cost_usd": 0.25,
              "provider_usage": [
                {
                  "cache_read_input_tokens": 3
                },
                {}
              ],
              "accounting_status": "not_asserted"
            }
          }
        }
      }
