-- UNACTIVATED U-DATA-02 proposal; no successor number assigned.
-- Role configuration is part of frozen ACL fingerprints. This must go through
-- a separately reviewed native authority transition and full pre/post raw
-- fingerprint measurement. Never run via application startup or psql hooks.
-- Requires explicit administrator scope because canonical owner is NOCREATEROLE.
DO $policy$
DECLARE
    prefix text := current_setting('agentforge.role_prefix');
    principal text;
    schemas text;
BEGIN
    IF current_user <> session_user OR NOT (SELECT rolsuper FROM pg_roles WHERE rolname=current_user) THEN
        RAISE EXCEPTION 'explicit administrator login required';
    END IF;
    IF prefix !~ '^[a-z][a-z0-9_]{0,20}_$' THEN
        RAISE EXCEPTION 'invalid canonical role prefix';
    END IF;
    FOREACH principal IN ARRAY ARRAY['gateway','runtime','capability_worker','knowledge_api','knowledge_worker'] LOOP
        IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname=prefix||principal AND rolcanlogin
            AND NOT (rolinherit OR rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls)) THEN
            RAISE EXCEPTION 'canonical application login required';
        END IF;
        -- Keep current source-approved schema order until inventory migration
        -- explicitly removes a schema; no CREATE, membership or ACL is granted.
        schemas := CASE WHEN principal IN ('knowledge_api','knowledge_worker')
            THEN 'pg_catalog,knowledge,gateway,assistant,public'
            ELSE 'pg_catalog,gateway,assistant,knowledge,public' END;
        EXECUTE format('ALTER ROLE %I CONNECTION LIMIT 32', prefix||principal);
        EXECUTE format('ALTER ROLE %I SET search_path = %s', prefix||principal, schemas);
        EXECUTE format('ALTER ROLE %I SET statement_timeout = %L', prefix||principal, '30s');
        EXECUTE format('ALTER ROLE %I SET idle_in_transaction_session_timeout = %L', prefix||principal, '15s');
    END LOOP;
END
$policy$;
